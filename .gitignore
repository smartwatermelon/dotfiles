# Default: ignore everything (safety net — new dirs are NOT auto-tracked)
/*

# ── Tracked directories ──────────────────────────────────
!bash/
!btop/
!dig/
!git/
!markdownlint-cli/
!pre-commit/
!shellcheck/
!tidy/
!vim/
!yamllint/
!yt-dlp/
!s/
!gh/
!docs/
# CI workflows. Previously tracked without an allow entry (added before the
# default-ignore rule), which meant a NEW workflow file was silently ignored.
!.github/
# Project-local pre-push extension (runs the bash test suite before push).
!.ralph/

# Within gh/, only track preferences (not auth)
gh/*
!gh/config.yml
!gh/.gitignore

# ── Root files ────────────────────────────────────────────
!.gitignore
!README.md
!liquidpromptrc
!install.sh
!Brewfile

# ── Global exclusions (belt-and-suspenders) ───────────────
**/.claude/
**/*.key
**/*.pem
**/*.p12
**/secrets.*
**/credentials.*
**/.env
**/.env.*
**/*.jsonl
