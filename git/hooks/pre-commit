#!/usr/bin/env bash
set -euo pipefail

# =========================================================
# RESPONSIBILITY SPLIT
# =========================================================
# This hook runs BEFORE git materializes the proposed commit message
# anywhere on disk (per `man githooks`), so it cannot pass the message
# to the AI reviewer. Keep deterministic, message-independent checks
# here: branch protection, symlink repair, linters via the pre-commit
# framework, and project-local .project-hooks/pre-commit extensions.
#
# AI code review now lives in the commit-msg hook, which receives the
# in-progress commit message file as $1 and forwards it to the reviewer
# via run-review.sh's --message-file=PATH flag.
#
# =========================================================
# BRANCH PROTECTION - Do not commit directly to main/master
# =========================================================
protected_branch_check() {
  local current_branch
  current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

  if [[ "${current_branch}" == "main" || "${current_branch}" == "master" ]]; then
    echo "" >&2
    echo "🛑 STOP: Direct commits to '${current_branch}' are not allowed." >&2
    echo "" >&2
    echo "   Create a feature branch first:" >&2
    echo "   git checkout -b <branch-name>" >&2
    echo "" >&2
    echo "   If you REALLY need to bypass this (you probably don't):" >&2
    echo "   OBTAIN EXPLICIT PERMISSION and then git commit --no-verify" >&2
    echo "" >&2
    exit 1
  fi
}
protected_branch_check

# =========================================================
# SYMLINK REPAIR — detect and fix atomic-write breakage
# =========================================================
# Editors and tools that do atomic writes (write temp, rename over target)
# replace symlinks with regular files. Detect and repair before linting.
_REPAIR_LIB="${HOME}/.config/git/hooks/lib-symlink-repair.sh"
if [[ -f "${_REPAIR_LIB}" ]]; then
  export REPO_DIR="${HOME}/Developer/dotfiles"
  # shellcheck source=lib-symlink-repair.sh
  source "${_REPAIR_LIB}"
  repair_config_symlinks true
fi

# =========================================================
# PRE-COMMIT FRAMEWORK — global config, then repo-local config
# =========================================================
# The global config always runs. A repo-local .pre-commit-config.yaml, if
# present, runs AFTER it and adds repo-specific hooks; it does not replace
# the global set. (Before this, a local file replaced the global config
# entirely, so any repo with one silently skipped the global secret scan,
# zizmor, yamllint and length caps.)
#
# Both passes run even when the global pass fails, so one commit attempt
# shows every error. That is safe with auto-fixers because each
# `pre-commit run` stashes unstaged changes, runs against the index, and
# restores the stash afterwards. A global fixer's edits are unstaged by the
# time the local pass starts, so they are stashed and restored intact. The
# one cost: if a local fixer edits the same file a global fixer already
# edited, pre-commit reports the conflict and rolls back the LOCAL fix (it
# never discards the stashed changes). The commit fails either way; the
# committer re-stages and commits again, and the local fixer applies on
# that pass. Verified by experiment with two overlapping `sed -i` fixers.
#
# A missing global config is an error even when a local config exists. The
# hook and the global config are deployed together by install.sh, so a
# missing global config means a broken install — and quietly running only
# the local config is exactly the skip this layout exists to prevent.
run_pre_commit_configs() {
  local local_config=".pre-commit-config.yaml"
  local global_config="${HOME}/.config/pre-commit/config.yaml"

  if ! command -v pre-commit >/dev/null 2>&1; then
    echo "[pre-commit] ERROR: 'pre-commit' command not found in PATH." >&2
    exit 1
  fi

  if [[ ! -f "${global_config}" && ! -f "${local_config}" ]]; then
    echo "[pre-commit] ERROR: No config found (expected ${local_config} or ${global_config})." >&2
    exit 1
  fi

  if [[ ! -f "${global_config}" ]]; then
    echo "[pre-commit] ERROR: Global config not found at ${global_config}." >&2
    echo "[pre-commit]        ${local_config} adds to the global config; it does not replace it." >&2
    echo "[pre-commit]        Re-run the dotfiles install.sh to restore the global config." >&2
    exit 1
  fi

  local failed=()

  echo "[pre-commit] Running with global config: ${global_config}"
  pre-commit run --config "${global_config}" "$@" || failed+=("global-config")

  if [[ -f "${local_config}" ]]; then
    echo "[pre-commit] Running with repo-local config: ${local_config}"
    pre-commit run --config "${local_config}" "$@" || failed+=("repo-local-config")
  fi

  if ((${#failed[@]} > 0)); then
    echo "[pre-commit] FAILED: ${failed[*]}. Fix the errors above, re-stage, and commit again." >&2
    exit 1
  fi
}
run_pre_commit_configs "$@"

# =========================================================
# PROJECT-LOCAL PRE-COMMIT EXTENSIONS
# =========================================================
# Repos can add a .project-hooks/pre-commit script for project-specific checks
# (e.g. typecheck-affected, test-affected, custom lints) that run after
# the global lint pass but before the expensive AI review. Symmetric
# with .project-hooks/pre-push — same trust model (if you cloned the repo and
# are committing to it, you trust its build tooling) and same +x
# activation requirement.
#
# Placed here deliberately so the cheaper project-local checks fail
# fast before the 60-120s AI review cycle spends compute on a diff
# the project already knows is broken.
run_project_extensions() {
  local repo_root
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
  if [[ -z "${repo_root}" ]]; then
    return 0
  fi

  local ext="${repo_root}/.project-hooks/pre-commit"
  if [[ -x "${ext}" ]]; then
    echo "[pre-commit] Running project-local pre-commit extension: ${ext}"
    if ! "${ext}"; then
      echo "" >&2
      echo "🛑 Project pre-commit extension failed — fix before committing." >&2
      echo "" >&2
      exit 1
    fi
  fi
}
run_project_extensions

# AI code review runs in the commit-msg hook (where the in-progress
# commit message is available as $1) — not here.

exit 0
